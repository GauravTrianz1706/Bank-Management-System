<?xml version="1.0" encoding="utf-8" ?>
<!--
  App.config for .NET 8 / net8.0-windows
  NOTE: The <startup> / <supportedRuntime> element is NOT used by .NET Core/.NET 5+.
  Connection strings are retained here for reference but should be migrated to
  appsettings.json / environment variables for .NET 8 applications.
-->
<configuration>
  <connectionStrings>
    <clear />
    <add name="OpenBankLocal"
         providerName="System.Data.SqlClient"
         connectionString="Data Source=.;Initial Catalog=OpenBankLocal;Integrated Security=True" />
  </connectionStrings>
  <!--
    REMOVED: <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" /></startup>
    This element is not applicable to .NET 8 and has been removed.
  -->
</configuration>
