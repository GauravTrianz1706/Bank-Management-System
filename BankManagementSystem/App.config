<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!--
    Connection strings have been migrated to environment variables for cloud-native configuration.
    The database connection string is now read from the BANKAPP_CONNECTION_STRING environment variable.
    Azure Service Bus connection string: AZURE_SERVICE_BUS_CONNECTION_STRING
    Azure Storage account URL: AZURE_STORAGE_ACCOUNT_URL
    Azure App Configuration endpoint: AZURE_APP_CONFIG_ENDPOINT
    Audit log base path (optional): AUDIT_LOG_BASE_PATH
    Customer logs container (optional): CUSTOMER_LOGS_CONTAINER
    Deposit cache container (optional): DEPOSIT_CACHE_CONTAINER
    
    This enables runtime configuration without rebuilding (12-factor app principle).
  -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
