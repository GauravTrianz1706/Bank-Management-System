<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!--
    Blocker-17 (cr-dotnet-0010): Web.config transformation-based connection strings
    have been replaced with environment variable configuration for GKE/cloud-native
    deployment. The connection string is now read from the OPENBANK_CONNECTION_STRING
    environment variable injected by Kubernetes ConfigMaps or Secret Manager.

    The connectionStrings section below is retained only as a local development
    fallback reference. In cloud (GKE) deployments, set the environment variable:
      OPENBANK_CONNECTION_STRING=<your-cloud-sql-connection-string>
  -->
  <connectionStrings>
    <clear />
    <!-- Local development fallback only. Cloud deployments use OPENBANK_CONNECTION_STRING env var. -->
    <add name="OpenBankLocal"
     providerName="System.Data.SqlClient"
     connectionString="Data Source=.;Initial Catalog=OpenBankLocal;Integrated Security=True" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
