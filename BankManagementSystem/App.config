<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <clear />
    <add name="OpenBankLocal"
     providerName="Microsoft.Data.SqlClient"
     connectionString="Data Source=.;Initial Catalog=OpenBankLocal;Integrated Security=True" />
  </connectionStrings>
  <!-- NOTE: The <startup> / <supportedRuntime> element is not used in .NET 8.
       Runtime selection is handled by the SDK and runtimeconfig.json. -->
</configuration>
