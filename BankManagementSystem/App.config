<configuration>
  <connectionStrings>
    <clear />
    <add name="OpenBankLocal"
     providerName="Microsoft.Data.SqlClient"
     connectionString="Data Source=.;Initial Catalog=OpenBankLocal;Integrated Security=True;TrustServerCertificate=True" />
  </connectionStrings>
</configuration>
