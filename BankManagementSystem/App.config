<?xml version="1.0" encoding="utf-8" ?>
<!--
  App.config for .NET 8 / net8.0-windows
  NOTE: The <startup> / <supportedRuntime> element is NOT used by .NET Core/.NET 5+.
  Connection strings have been migrated to PostgreSQL format.
  For .NET 8 applications, prefer appsettings.json / environment variables
  over App.config for connection string management.
-->
<configuration>
  <connectionStrings>
    <clear />
    <add name="OpenBankLocal"
         providerName="Npgsql"
         connectionString="Host=localhost;Port=5432;Database=OpenBank;Username=postgres;Password=postgres;Pooling=true;MinPoolSize=1;MaxPoolSize=20;ConnectionIdleLifetime=300;CommandTimeout=30;" />
  </connectionStrings>
  <!--
    REMOVED: <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" /></startup>
    This element is not applicable to .NET 8 and has been removed.
    CHANGED: providerName updated from System.Data.SqlClient to Npgsql.
    CHANGED: connectionString updated from SQL Server format to PostgreSQL format.
  -->
</configuration>
