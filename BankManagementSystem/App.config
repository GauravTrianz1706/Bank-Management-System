<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <clear />
    <add name="OpenBankLocal"
     providerName="Npgsql"
     connectionString="Host=localhost;Database=openbanklocal;Username=postgres;Password=postgres;Port=5432;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=100;Connection Lifetime=0;Timeout=30;" />
  </connectionStrings>
</configuration>
