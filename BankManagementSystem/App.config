<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <clear />
    <add name="OpenBankLocal"
     providerName="Npgsql"
     connectionString="Host=localhost;Port=5432;Database=OpenBankLocal;Username=postgres;Password=your_password;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=20;Connection Idle Lifetime=300;Command Timeout=30;" />
  </connectionStrings>
  <!-- NOTE: The <startup> / <supportedRuntime> element is not used in .NET 8.
       Runtime selection is handled by the SDK and runtimeconfig.json. -->
</configuration>
