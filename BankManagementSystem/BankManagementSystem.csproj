<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BankManagementSystem</RootNamespace>
    <AssemblyName>BankManagementSystem</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Newtonsoft.Json 13.0.3 - latest stable, .NET 8 compatible -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- log4net 2.0.17 - .NET 8 compatible -->
    <PackageReference Include="log4net" Version="2.0.17" />
    <!-- HtmlAgilityPack 1.11.61 - .NET 8 compatible -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />
    <!-- Newtonsoft.Json.Bson 1.0.3 - .NET 8 compatible -->
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BankDatabaseAccess\BankDatabaseAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\Logo.png" />
    <None Include="Resources\dpHolder.png" />
    <None Include="Resources\cardHolder.png" />
    <None Include="Resources\getStarted_.png" />
    <None Include="Resources\gitIcon.png" />
  </ItemGroup>

</Project>
