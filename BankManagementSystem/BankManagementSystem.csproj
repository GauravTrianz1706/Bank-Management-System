<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BankManagementSystem</RootNamespace>
    <AssemblyName>BankManagementSystem</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <!-- Restore locked mode disabled to allow package resolution on .NET 8 -->
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet packages updated to .NET 8 compatible versions -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="log4net" Version="2.0.15" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <!-- System.Configuration.ConfigurationManager required for Settings.Designer.cs (ApplicationSettingsBase) -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <!--
      Microsoft.AspNetCore.App is a built-in shared framework reference in .NET 8.
      It is NOT referenced as a NuGet PackageReference in .NET 8 projects.
      If ASP.NET Core features are needed, use:
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
      System.Messaging (MSMQ) is NOT available on .NET 8; removed entirely.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BankDatabaseAccess\BankDatabaseAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\Logo.png" />
    <None Include="Resources\dpHolder.png" />
    <None Include="Resources\cardHolder.png" />
    <None Include="Resources\getStarted_.png" />
    <None Include="Resources\gitIcon.png" />
  </ItemGroup>

</Project>
