{
  "family": "bankdatabaseaccess-task",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "bankdatabaseaccess",
      "image": "{{IMAGE_URI}}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DOTNET_ENVIRONMENT",
          "value": "Production"
        },
        {
          "name": "HEALTH_CHECK_PORT",
          "value": "8080"
        },
        {
          "name": "CURRENT_USER",
          "value": "containeruser"
        },
        {
          "name": "TZ",
          "value": "UTC"
        },
        {
          "name": "DB_CONNECTION_STRING",
          "value": "{{DB_CONNECTION_STRING}}"
        },
        {
          "name": "DB_SERVER",
          "value": "{{DB_SERVER}}"
        },
        {
          "name": "DB_NAME",
          "value": "{{DB_NAME}}"
        },
        {
          "name": "DB_USER",
          "value": "{{DB_USER}}"
        },
        {
          "name": "DB_PASSWORD",
          "value": "{{DB_PASSWORD}}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bankdatabaseaccess",
          "awslogs-region": "{{AWS_REGION}}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
