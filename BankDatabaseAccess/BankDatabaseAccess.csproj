<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BankDatabaseAccess</RootNamespace>
    <AssemblyName>BankDatabaseAccess</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Npgsql 8.0.5 - PostgreSQL ADO.NET provider for .NET 8 -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 8.0.0 - EF Core provider for PostgreSQL -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <!-- EFCore.NamingConventions 8.0.0 - snake_case naming convention support -->
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.0" />
    <!-- Microsoft.EntityFrameworkCore 8.0.0 - EF Core base package -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <!-- Microsoft.EntityFrameworkCore.Relational 8.0.0 - EF Core relational support -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.0" />
    <!-- Microsoft.Extensions.Configuration.Abstractions 8.0.0 - aligned with .NET 8 -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <!-- Newtonsoft.Json 13.0.3 - latest stable, .NET 8 compatible -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Newtonsoft.Json.Bson 1.0.3 - .NET 8 compatible -->
    <PackageReference Include="Newtonsoft.Json.Bson" Version="1.0.3" />
    <!-- log4net 2.0.17 - .NET 8 compatible -->
    <PackageReference Include="log4net" Version="2.0.17" />
    <!-- HtmlAgilityPack 1.11.61 - .NET 8 compatible -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.61" />
  </ItemGroup>

</Project>
