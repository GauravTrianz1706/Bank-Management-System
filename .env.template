# Bank Management System - Environment Variables Configuration
# Copy this file to .env and update with your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Option 1: Use full connection string (recommended for production)
DB_CONNECTION_STRING=Data Source=your-server.database.windows.net;Initial Catalog=BankDB;User Id=dbuser;Password=YourSecurePassword;Encrypt=True;TrustServerCertificate=False;

# Option 2: Use individual components (for development)
# DB_HOST=localhost
# DB_NAME=OpenBankLocal
# DB_USER=sa
# DB_PASSWORD=YourPassword123

# ============================================================================
# USER AUTHENTICATION
# ============================================================================
# Current user for employee sessions (fallback: Environment.UserName)
CURRENT_USER=containeruser

# Startup user for application initialization (fallback: Environment.UserName)
STARTUP_USER=appuser

# ============================================================================
# FILE SYSTEM PATHS
# ============================================================================
# Employee audit log directory (fallback: system temp directory)
AUDIT_LOG_PATH=/app/logs/audit

# Customer access log directory (fallback: system temp directory)
CUSTOMER_LOG_PATH=/app/logs/customer

# Deposit cache directory (fallback: system temp directory)
DEPOSIT_CACHE_PATH=/app/cache/deposits

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application configuration value (fallback: "default-config")
# In production, migrate to Azure App Configuration
BANK_APP_CONFIG=production-config

# ============================================================================
# HEALTH CHECK CONFIGURATION
# ============================================================================
# HTTP port for health check endpoint (default: 8080)
HEALTH_CHECK_PORT=8080

# ============================================================================
# PRODUCTION RECOMMENDATIONS
# ============================================================================
# 1. Use Azure Key Vault for DB_CONNECTION_STRING and DB_PASSWORD
# 2. Use Azure App Configuration for BANK_APP_CONFIG
# 3. Mount Azure Files or Blob Storage for log directories
# 4. Use Azure AD (Entra ID) for user authentication
# 5. Enable Workload Identity for credential-free access to Azure services
