# Bank Management System - Environment Variables Configuration
# Copy this file to .env and update with your actual values

# User Configuration
CURRENT_USER=container_user

# File System Paths (use Linux-style paths for Linux containers, Windows-style for Windows containers)
AUDIT_LOG_PATH=/app/logs/audit
CUSTOMER_LOGS_PATH=/app/logs/customer
DEPOSIT_CACHE_PATH=/app/cache/deposit

# Application Configuration
BANK_APP_CONFIG=production
HEALTH_CHECK_PORT=8080

# Database Configuration
DB_HOST=sqlserver
DB_NAME=OpenBankLocal
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd

# Alternative: Use full connection string (overrides individual DB_* variables)
# DB_CONNECTION_STRING=Data Source=sqlserver;Initial Catalog=OpenBankLocal;User Id=sa;Password=YourStrong@Passw0rd

# AWS Configuration (for production deployments)
# AWS_REGION=us-east-1
# AWS_SECRET_NAME=bank-management-db-credentials
# AWS_PARAMETER_STORE_PATH=/bank-management/config
