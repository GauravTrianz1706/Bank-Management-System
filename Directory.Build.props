<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Common package versions -->
    <PackageReference Update="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Update="log4net" Version="2.0.17" />
    <PackageReference Update="HtmlAgilityPack" Version="1.11.59" />
    <PackageReference Update="Newtonsoft.Json.Bson" Version="1.0.2" />
    <PackageReference Update="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Update="Microsoft.Data.SqlClient" Version="5.1.5" />
    <PackageReference Update="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>
</Project>
